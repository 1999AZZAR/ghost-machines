# Ghost Machines - Architecture & Security Parameters

# [Required for Remote Mode]
# Your Cloudflare Tunnel Token
TUNNEL_TOKEN=

# [Optional] Security & Non-Root User Sync
# Automatically detected from host if left blank
HOST_UID=
HOST_GID=
GHOST_USER=developer

# [Optional] SSH Security & Key Injection
# Set to 'false' to disable password authentication when using SSH keys
SSH_PASSWORD_AUTH=true
# Path to host public key (auto-detected from ~/.ssh/*.pub if left blank)
SSH_AUTH_KEY_PATH=

# [Optional] Local HeLa MCP Ecosystem Mount
# Mounts your local clone of hela-mcp-ecosystem into /opt/mcp-ecosystem-local
MCP_ECOSYSTEM_LOCAL_PATH=/home/azzar/project/MCPservers/mcp-ecosystem

# [Optional] Port Overrides
G1_PORT=2223
G2_PORT=2224

# [Optional] Custom Container Names
G1_NAME=ghost-machine1
G2_NAME=ghost-machine2

# [Optional] Resource Overrides (Values like 1.0, 8G, etc.)
# Note: These are automatically managed by start.sh unless set here.
G1_CPU=
G1_MEM=
G2_CPU=
G2_MEM=
